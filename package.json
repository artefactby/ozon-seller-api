{
  "name": "artefactby-ozon-seller-api",
  "version": "0.0.1",
  "description": "Unofficial typed TypeScript client for the Ozon Seller API. Zero runtime dependencies.",
  "keywords": [
    "ozon",
    "ozon-seller",
    "ozon-api",
    "seller-api",
    "marketplace",
    "api-client",
    "typescript",
    "sdk"
  ],
  "homepage": "https://github.com/artefactby/ozon-seller-api#readme",
  "bugs": "https://github.com/artefactby/ozon-seller-api/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artefactby/ozon-seller-api.git"
  },
  "license": "GPL-3.0-only",
  "author": "artefactby (https://artefact.by)",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./limiter": {
      "import": {
        "types": "./dist/limiter/index.d.mts",
        "default": "./dist/limiter/index.mjs"
      },
      "require": {
        "types": "./dist/limiter/index.d.ts",
        "default": "./dist/limiter/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "codegen": "openapi-typescript temp/swagger.json -o src/generated/types.ts && node scripts/emit-http-methods.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
